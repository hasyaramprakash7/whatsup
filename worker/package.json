{
  "name": "whatsapp-agent-worker",
  "version": "4.0.0",
  "private": true,
  "description": "Any-business WhatsApp agent on Cloudflare: Workers, D1, Durable Objects, Workers AI, R2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/release.mjs",
    "db:migrate:local": "wrangler d1 migrations apply whatsapp-agent --local",
    "db:migrate:remote": "wrangler d1 migrations apply whatsapp-agent --remote",
    "test": "node --test --experimental-test-module-mocks --no-warnings \"test/**/*.test.js\"",
    "deploy:staging": "npm test && wrangler deploy --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply whatsapp-agent-staging --remote --env staging",
    "deploy:quick": "npm test && wrangler deploy",
    "check:staging": "node scripts/staging-check.mjs smoke"
  },
  "dependencies": {
    "hono": "4.13.19"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
