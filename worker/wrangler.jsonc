{
  // WhatsApp agent for any business — one Worker serves the dashboard, API, WebSockets and Meta webhook.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-agent",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Dashboard files. API, webhook, WebSocket and health routes run in the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook", "/webhook/*", "/ws", "/health", "/push/*", "/auth/*"]
  },

  // Abuse protection: per-address limits for the dashboard API and for wrong sign-in keys.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "4101", "simple": { "limit": 600, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }
  ],

  // Businesses, flows, leads and every chat message (SQLite).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whatsapp-agent",
      "database_id": "ec7cb500-d48c-4116-a64a-f5ad5e331864",
      "migrations_dir": "migrations"
    }
  ],

  // ConversationDO: one per customer chat (ordering, flow state, never-lost inbox).
  // BusinessHub: one per business (live dashboard WebSockets, broadcast pacing).
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATION", "class_name": "ConversationDO" },
      { "name": "HUB", "class_name": "BusinessHub" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationDO", "BusinessHub"] }],

  // Brochures and other documents sent to customers.
  // MEDIA: public (product photos, brochures — WhatsApp fetches them by link).
  // PRIVATE_MEDIA: customers' photos, voice notes and documents — no public link; read only through /api/media.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "rk-interior-media" },
    { "binding": "PRIVATE_MEDIA", "bucket_name": "whatsapp-agent-private" }
  ],

  // Workers AI for the assistant.
  "ai": { "binding": "AI" },

  // Monitor: every 10 minutes check that customers get replies and alert the admin's phone if not.
  "triggers": { "crons": ["*/10 * * * *"] },

  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GRAPH_API_VERSION": "v25.0",
    "GRAPH_BASE_URL": "https://graph.facebook.com",
    "R2_PUBLIC_BASE_URL": "https://pub-8d93705764b8407a957deeec1fc05dda.r2.dev",
    "SITE_UTC_OFFSET": "+05:30",
    "DEFAULT_BROADCAST_TEMPLATE": "realestate_reengage_v1",
    "DEFAULT_BROADCAST_LANGUAGE": "en",
    "BROADCAST_RATE_PER_SECOND": "10",
    "RETENTION_DAYS": "365",
    // Contact for phone push services (Web Push VAPID "sub")
    "VAPID_SUBJECT": "https://whatsapp-agent.hasya7893828468.workers.dev"
  }
  // Secrets (wrangler secret put / .dev.vars): ADMIN_API_KEY, META_APP_SECRET, WHATSAPP_VERIFY_TOKEN, TOKEN_ENCRYPTION_KEY
}
