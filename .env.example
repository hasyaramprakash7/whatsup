NODE_ENV=development
PORT=3000
CORS_ORIGINS=
# Number of reverse-proxy hops to trust for client IPs (docker-compose sets 1 for Caddy)
TRUST_PROXY=

# --- Server hosting (docker-compose only) ---
# Public domain for the dashboard + webhook; its DNS A record must point at the server.
APP_DOMAIN=
# On the server, REDIS_PASSWORD (below) is REQUIRED — generate with: openssl rand -hex 24
# (REDIS_HOST, REDIS_PORT and MONGO_URI are set by docker-compose automatically.)

# Master key for the admin dashboard/API. Generate with: openssl rand -hex 32 (min 32 chars)
ADMIN_API_KEY=

MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_realestate

# Either REDIS_URL, or REDIS_HOST/PORT/PASSWORD
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Graph API version used for sending (defaults to v25.0)
META_GRAPH_API_VERSION=

# Cloudflare R2 (brochure hosting) — optional; leave empty to run without brochure uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Broadcast template (defaults: realestate_reengage_v1 / en / true).
# To test with Meta's sample: hello_world / en_US / false
BROADCAST_TEMPLATE_NAME=
BROADCAST_TEMPLATE_LANG=
BROADCAST_TEMPLATE_PARAMS=

# Skip numbers that were broadcast to within this many days (empty/0 = no cooldown).
# Opted-out leads are always skipped.
BROADCAST_COOLDOWN_DAYS=

# Approved template for admin alerts (strongly recommended). Without it, alerts are plain text,
# which WhatsApp only delivers if the admin phone messaged the business number in the last 24h.
# Body variables: {{1}} headline, {{2}} lead name, {{3}} lead phone, {{4}} details
ADMIN_ALERT_TEMPLATE_NAME=
ADMIN_ALERT_TEMPLATE_LANG=

# Site time zone as a UTC offset, used for visit-slot dates (default +05:30, IST)
SITE_UTC_OFFSET=

# Optional broadcast tuning
BROADCAST_CONCURRENCY=
BROADCAST_RATE_MAX=
BROADCAST_RATE_DURATION_MS=
BROADCAST_ATTEMPTS=
BROADCAST_BACKOFF_MS=
